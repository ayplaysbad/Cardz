    padding-bottom: 180px;
}

.board-scroll-container .unity-scroll-view__content-and-vertical-scroll-container,
.board-scroll-container .unity-scroll-view__content-viewport {
    width: 100%;
    margin-right: 0;
    padding-right: 0;
}

.zoom-panel-right {
    position: absolute;
    left: 36px;
    bottom: 10px;
    flex-direction: column;
    align-items: center;
    background-color: transparent;
    padding: 0;
    z-index: 100;
    transition-property: bottom;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}

.zoom-btn {
    width: 58px;
    height: 58px;
    margin: 6px 0;
    -unity-font: url("project://database/Assets/UI/Fonts/PermanentMarker-Regular.ttf?fileID=12800000&guid=f0368353c79b6aa4fa9c7d47021796c4&type=3#PermanentMarker-Regular");
    -unity-font-definition: initial;
    font-size: 36px;
    color: rgb(51, 51, 51);
    background-image: url("project://database/Assets/UI/Sprites/card_base_wobbly.png?fileID=6304497287864835111&guid=ff140ca78719a8648a67101695d8f646&type=3#card_base_wobbly_0");
    -unity-background-image-tint-color: rgb(255, 210, 127);
    background-color: transparent;
    border-width: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.stack-btn.stack-btn-bounce {
    scale: 1.12 1.12;
    translate: 0 -8px;
}

.zoom-btn:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.08;
}

.zoom-btn:active {
    -unity-background-image-tint-color: rgb(255, 210, 127);
    scale: 0.95;
}

.focus-btn {
    justify-content: center;
    align-items: center;
}

.square-focus-icon {
    width: 22px;
    height: 22px;
    border-width: 3px;
    border-color: rgb(51, 51, 51);
    border-radius: 4px;
    background-color: transparent;
}

.play-area-wrapper {
    flex-grow: 1;
    width: 100%;
    position: relative;
    margin-top: 10px;
    margin-bottom: 20px;
}

.mobile-dock-toggle {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 132px;
    translate: 0 -50%;
    background-image: url("project://database/Assets/UI/Sprites/postit_note_yellow.png?fileID=-7798892719133297459&guid=43bc4a074f4aeb148989bd1aaa481925&type=3#postit_note_yellow_0");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 246, 212, 0.96);
    border-width: 0;
    color: rgb(61, 61, 61);
    -unity-font: url("project://database/Assets/UI/Fonts/PermanentMarker-Regular.ttf?fileID=12800000&guid=f0368353c79b6aa4fa9c7d47021796c4&type=3#PermanentMarker-Regular");
    -unity-font-definition: initial;
    font-size: 32px;
    -unity-text-align: middle-center;
    display: none;
    z-index: 320;
}

.mobile-dock-toggle-left {
    left: -6px;
}

.mobile-dock-toggle-right {
    right: -6px;
}

.mobile-dock-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(37, 33, 29, 0.28);
    display: none;
    z-index: 250;
}

.mobile-dock-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 78%;
    min-width: 78%;
    max-width: 78%;
    height: 100%;
    display: none;
    z-index: 260;
}

.mobile-dock-panel-left {
    left: 0;
}

.mobile-dock-panel-right {
    right: 0;
}

.mobile-dock-inner {
    width: 100%;
    height: 100%;
    position: relative;
    justify-content: stretch;
    align-items: stretch;
}

.mobile-dock-header {
    position: absolute;
    left: 12px;
    right: 12px;
