.tile-card-content {
    position: absolute;
    left: 9px;
    top: 9px;
    right: 9px;
    bottom: 9px;
    width: auto;
    height: auto;
    justify-content: stretch;
    align-items: stretch;
    padding: 0;
}

.resolve-motion-proxy {
    position: absolute;
    overflow: visible;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0);
    translate: 0 0;
    opacity: 1;
    scale: 1 1;
    transition-property: translate, opacity, scale;
    transition-duration: 0.34s;
    transition-timing-function: ease-in-out;
}

.resolve-motion-proxy-move-active {
    transition-duration: 0.46s;
    transition-timing-function: ease-in-out;
}

.resolve-motion-proxy-attack-active {
    transition-duration: 0.24s;
    transition-timing-function: ease-in;
}

.resolve-motion-proxy-death-active {
    transition-duration: 0.3s;
    transition-timing-function: ease-in;
    opacity: 0;
    scale: 0.84 0.84;
}

.resolve-motion-intent-badge {
    top: 8px;
}

.resolve-motion-proxy .tile-card-content {
    border-radius: 12px;
    overflow: hidden;
}

.resolve-motion-proxy .tile-art-placeholder {
    border-radius: 12px;
}

.resolve-motion-proxy .tile-ownership-frame {
    border-radius: 13px;
}

.resolve-motion-proxy .tile-selection-glow {
    border-radius: 22px;
}

