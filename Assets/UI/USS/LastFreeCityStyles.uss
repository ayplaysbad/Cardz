.controls-row {
    transition-property: height, opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
    opacity: 1;
    translate: 0 0;
    overflow: visible;
}

.controls-row.hud-hidden {
    display: flex;
    height: 0;
    opacity: 0;
    translate: 0 350px;
    overflow: hidden;
}

.tile-deployed-swoosh {
    transition-property: scale, translate, opacity, rotate;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-back;
    scale: 0.1;
    opacity: 0;
    rotate: -12deg;
    translate: 0 80px;
}

.tile-deployed-active {
    scale: 1;
    opacity: 1;
    rotate: 0;
    translate: 0 0;
}
