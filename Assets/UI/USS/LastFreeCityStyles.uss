.board-surface {
    position: relative;
    align-self: center;
}

.board-ownership-frame {
    position: absolute;
    left: -14px;
    top: -14px;
    right: -14px;
    bottom: -14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 8px;
    border-radius: 22px;
    opacity: 0.52;
}

.board-ownership-frame-seat-one {
    border-color: rgba(92, 149, 235, 0.72);
}

.board-ownership-frame-seat-two {
    border-color: rgba(231, 113, 113, 0.72);
}

.board-ownership-timer-layer {
    position: absolute;
    left: -14px;
    top: -14px;
    right: -14px;
    bottom: -14px;
    overflow: visible;
}

.board-ownership-timer-edge {
    position: absolute;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.94);
    opacity: 1;
}

.board-ownership-timer-seat-one .board-ownership-timer-edge {
    background-color: rgba(58, 138, 255, 0.98);
}

.board-ownership-timer-seat-two .board-ownership-timer-edge {
    background-color: rgba(255, 84, 84, 0.98);
}

.board-grid-layer {
    position: absolute;
