    top: 0;
}

.board-effects-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.board-motion-layer {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
}

.board-row {
    flex-direction: row;
    justify-content: flex-start;
    width: auto;
}

