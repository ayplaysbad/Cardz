.safe-area-root {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}

.main-canvas {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    justify-content: space-between;
    background-image: url("project://database/Assets/UI/Sprites/notebook_ruled_paper_bg.png?fileID=-957183366294213520&guid=987ea6dba28a222499c393e3ecf476c0&type=3#notebook_ruled_paper_bg_0");
    -unity-background-scale-mode: stretch-to-fill;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 0;
    padding-right: 0;
}

.gameplay-shell {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    min-width: 0;
}

.center-stage-shell {
    flex-grow: 1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.center-stage-content {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    position: relative;
}

.desktop-board-column {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
}

.desktop-control-strip {
    display: none;
}

.desktop-side-dock {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    height: 100%;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: center;
    padding-top: 22px;
    padding-bottom: 22px;
}

.gameplay-shell.desktop-dock-layout {
    padding-left: 0;
    padding-right: 0;
}

.gameplay-shell.desktop-dock-layout .center-stage-shell {
    width: auto;
    min-width: 0;
    max-width: none;
    flex-grow: 1;
}

.gameplay-shell.desktop-dock-layout .desktop-side-dock {
    display: flex;
}

.desktop-side-dock-left {
    padding-right: 0;
}

.desktop-side-dock-right {
    padding-left: 0;
}

.desktop-dock-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 22px 16px 18px;
    background-image: url("project://database/Assets/UI/Sprites/postit_note_yellow.png?fileID=-7798892719133297459&guid=43bc4a074f4aeb148989bd1aaa481925&type=3#postit_note_yellow_0");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 252, 241, 0.92);
    justify-content: flex-start;
    align-items: stretch;
}

.desktop-dock-kicker {
    -unity-font: url("project://database/Assets/UI/Fonts/ArchitectsDaughter-Regular.ttf?fileID=12800000&guid=518c30485137fe843810d48fcadf99e9&type=3#ArchitectsDaughter-Regular");
    -unity-font-definition: initial;
